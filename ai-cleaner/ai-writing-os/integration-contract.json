{
  "schemaVersion": 4,
  "name": "AI Cleaner Blog Factory Daily Engine contract",
  "version": "1.8.8",
  "runtime": "github-pages-actions-daily-engine-with-local-prompt-builder",
  "flow": [
    "scheduled topic generation",
    "daily-topics.json",
    "visible topic cards",
    "selected topic to prompt builder",
    "manual copy"
  ],
  "providerSelection": false,
  "providerLaunch": false,
  "nativeShareDelivery": false,
  "apiKeyInBrowser": false,
  "dailyEngine": {
    "enabled": true,
    "scheduler": "GitHub Actions",
    "timezone": "Asia/Seoul",
    "schedule": "06:20 daily",
    "output": "ai-cleaner/data/daily-topics.json",
    "topicCount": 10,
    "topCount": 3,
    "remoteAi": "OpenAI Responses API",
    "webSearchTool": true,
    "secret": "OPENAI_API_KEY",
    "requiredVariable": "BLOG_FACTORY_SEED",
    "deploy": "same workflow via GitHub Pages artifact/deploy actions"
  },
  "dailyLocalAutomation": {
    "enabled": true,
    "label": "로컬 프롬프트 자동 준비",
    "trigger": "first app open on a new local date",
    "requiresSavedSeed": true,
    "runsWhileBrowserClosed": false,
    "callsRemoteAi": false,
    "role": "fallback/helper separate from Daily Engine"
  },
  "unattendedAutomation": {
    "implemented": true,
    "runsWhileBrowserClosed": true,
    "secretBoundary": "GitHub Actions secret only; never shipped to Pages bundle"
  }
}
