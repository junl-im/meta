{
  "name": "AI COMPANY OS",
  "version": "7",
  "sourcePackage": "AI_COMPANY_OS_V7_ZERO_DEPENDENCY",
  "runtime": "GitHub Pages + GitHub Actions Daily Engine + local Blog Factory prompt compiler",
  "defaultLanguage": "ko",
  "portableZip": "AI_COMPANY_OS_V7_ZERO_DEPENDENCY.zip",
  "publicProfileMode": true,
  "remoteMcpLive": false,
  "fastFiles": [
    "00_OPEN_FIRST.md",
    "01_OWNER_PROFILE.md",
    "02_DEFAULTS_AND_BOUNDARIES.md",
    "03_TASK_ROUTER.md",
    "04_BLOG_CORE.md",
    "05_INSTAGRAM_CORE.md",
    "06_PRODUCT_ENTERPRISE_CORE.md",
    "07_STATE_AND_UPDATE.md"
  ],
  "promptCompiler": "prompt-compiler.json",
  "blogFactory": {
    "enabled": true,
    "presets": [
      "daily_topics",
      "daily_one",
      "batch_three",
      "idea_bank",
      "free"
    ],
    "designBridge": true,
    "truthGuard": true,
    "creator10": true,
    "dailyEngine": {
      "enabled": true,
      "output": "../data/daily-topics.json",
      "topicCount": 10,
      "topCount": 3,
      "scheduler": "GitHub Actions"
    }
  }
}
