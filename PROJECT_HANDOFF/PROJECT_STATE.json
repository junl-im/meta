{
  "project": "AI Cleaner / 곰같은여우의 AI 흔적 지우개",
  "version": "6.8.4",
  "date": "2026-08-15",
  "repo": "junl-im/meta",
  "pages": "https://junl-im.github.io/meta/",
  "appPath": "ai-cleaner/",
  "defaultBranch": "main",
  "deployment": "GitHub Pages branch deployment from main/root",
  "protectedPaths": [
    "OPTION/**"
  ],
  "userWorkflow": "receive ZIP -> overwrite local meta -> GitHub Desktop commit -> push",
  "criticalSafety": [
    "preserve meaning-sensitive Unicode by default",
    "no detector-bypass scoring",
    "no external synthetic typing/keystroke automation"
  ],
  "primaryFiles": [
    "index.html",
    "ai-cleaner/index.html",
    "ai-cleaner/css/app.css",
    "ai-cleaner/js/app.js",
    "ai-cleaner/js/rewrite-studio.js",
    "ai-cleaner/js/image-analyzer.js",
    "ai-cleaner/version.json",
    ".github/workflows/ai-cleaner-ci.yml"
  ],
  "handoff": "Read PROJECT_HANDOFF/AI_CLEANER_HANDOFF.md first.",
  "current_version": "6.8.4",
  "asset_version": "684",
  "browser_ci": "Playwright 1.62.1",
  "update_restore": true,
  "undo_redo_diff": true,
  "latestPatch": "v6.8.4 internal result typewriter: original -> result one grapheme at a time, exact verification",
  "rewriteStudio": {
    "factLock": true,
    "directTypingVerifier": true,
    "externalSyntheticTyping": false,
    "lazyLoaded": true,
    "staleDraftGuard": true,
    "sessionRecovery": true,
    "factLockLimit": 240,
    "detectorEvasionOptimization": false,
    "originalDirectWrite": true,
    "directWriteTarget": "original-only",
    "clipboardBlockedInDirectWrite": true,
    "syntheticInputBlockedInDirectWrite": true,
    "verifiedTypedResultApply": true,
    "exactOriginalAutoClone": false
  },
  "artifactDelivery": {
    "alwaysProvide": [
      "FULL_PROJECT_HANDOFF.zip",
      "Patch.zip"
    ],
    "patchIncludesOnlyChangedFiles": true,
    "protectedPathsExcluded": [
      "OPTION/**"
    ]
  },
  "internalTypewriter": {
    "source": "original",
    "target": "result textarea",
    "clipboard": false,
    "syntheticKeyboardEvents": false,
    "incrementalSetRangeText": true,
    "exactVerification": true
  }
}
